    "bwip-js": "^4.5.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.0",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.0",
    "extract-zip": "^2.0.1",
    "helmet": "^8.0.0",
    "ipaddr.js": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
