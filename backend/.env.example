# Database
DATABASE_URL="postgresql://user:password@localhost:5432/warehouse?schema=public"

# JWT - IMPORTANT: Change these in production! (generate with: openssl rand -base64 64)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3001
# BIND_ADDRESS=127.0.0.1  # Use 127.0.0.1 in production behind reverse proxy
NODE_ENV=development

# LDAP (optional)
# LDAP_URL="ldap://your-ldap-server:389"
# LDAP_BIND_DN="cn=admin,dc=example,dc=com"
# LDAP_BIND_PASSWORD="ldap-admin-password"
# LDAP_SEARCH_BASE="ou=users,dc=example,dc=com"
# LDAP_SEARCH_FILTER="(uid={{username}})"

# SMTP (for password reset & notifications)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="noreply@example.com"
# SMTP_PASSWORD="smtp-password"
# SMTP_FROM="Warehouse <noreply@example.com>"

# Frontend URL (for CORS). Leave empty to allow all origins.
# Set to restrict CORS to specific origins (comma-separated for multiple).
# Example: FRONTEND_URL="https://warehouse.example.com"
FRONTEND_URL=

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Encryption (32-byte hex string for AES-256-GCM - generate with: openssl rand -hex 32)
# IMPORTANT: Change this in production!
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# GitHub Repository (for update checks, forks can override this)
GITHUB_REPO="manjotsc/warehouse"

# Nginx Logs (optional - for nginx log integration in admin logs viewer)
# NGINX_ACCESS_LOG="/var/log/nginx/access.log"
# NGINX_ERROR_LOG="/var/log/nginx/error.log"
